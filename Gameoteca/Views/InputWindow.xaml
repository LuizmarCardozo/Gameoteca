<Window x:Class="Gameoteca.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gameoteca - Editar" Height="180" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Border Background="#1A0B34" BorderBrush="#4B2A86" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="LblTitle" Text="Editar Texto" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

            <TextBox x:Name="TxtInput" Grid.Row="1" 
                     Height="36" 
                     Padding="10,8"
                     Background="#0F0521" 
                     Foreground="White" 
                     BorderBrush="#4B2A86"
                     CaretBrush="#C084FC"
                     FontSize="14"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,15,0,0">
                <Button Content="Cancelar" IsCancel="True" Click="Cancel_Click"
                        Background="Transparent" Foreground="#D6C8FF" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                <Button Content="Salvar" IsDefault="True" Click="Ok_Click"
                        Background="#A855F7" Foreground="White" BorderThickness="0" 
                        Padding="20,8" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>