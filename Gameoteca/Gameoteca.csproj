<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Assets\APP.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Assets\APP.ico" />
	</ItemGroup>

	<!-- SPLASH SCREEN
	     IMPORTANTE: usamos <Resource> e NAO <SplashScreen>. Com <SplashScreen>, o WPF gera
	     codigo no Main() que exibe a splash automaticamente ANTES do OnStartup. Como o App.xaml.cs
	     ja cria e controla a sua propria splash (3s + fade), as duas apareciam ao mesmo tempo.
	     Com <Resource>, a imagem so e embutida no .exe e quem exibe e apenas o seu codigo. -->
	<ItemGroup>
		<Resource Include="Assets\SPLASH.jpg" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Data\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
		<PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
	</ItemGroup>

</Project>