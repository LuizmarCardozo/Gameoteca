<Window x:Class="Gameoteca.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gameoteca"
        mc:Ignorable="d"
        Title="Gameoteca"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        FontFamily="Segoe UI"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A855F7" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="0.55"/>
            <GradientStop Color="#4C1D95" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1A0B34"/>
            <Setter Property="BorderBrush" Value="#4B2A86"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1A0B34" BorderBrush="#4B2A86" BorderThickness="1" Padding="4" CornerRadius="8">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D6C8FF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Path Grid.Column="2" x:Name="Arrow" Data="M0,0 L4,3.5 L0,7 Z" Fill="#D6C8FF" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4B2A86"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#4B2A86"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" SnapsToDevicePixels="true"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="BorderBrush" Value="#C084FC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3A1230"/>
            <Setter Property="BorderBrush" Value="#FF7AB6"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#1A0B34"/>
            <Setter Property="BorderBrush" Value="#4B2A86"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderBrush" Value="#4B2A86"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#1A0B34"/>
            <Setter Property="CaretBrush" Value="#F3E8FF"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#C084FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" IsItemsHost="True" Margin="0,0,0,15"/>
                            <Border Grid.Row="1" Background="#0F0521" BorderBrush="#4B2A86" BorderThickness="1" CornerRadius="12" Padding="12">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#D6C8FF"/>
            <Setter Property="Background" Value="#1A0B34"/>
            <Setter Property="BorderBrush" Value="#4B2A86"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#231045"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C084FC"/>
                                <Setter Property="Foreground" Value="#F3E8FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryGradient}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C084FC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#08FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#100524"/>
            <Setter Property="Foreground" Value="#F3E8FF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#4B2A86"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4C1D95"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B0B38"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4C1D95"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A0B34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B2A86"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Fill="#C084FC" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1A0B34" BorderThickness="1" BorderBrush="#C084FC"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#D6C8FF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4B2A86"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A855F7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#070010" Offset="0"/>
                <GradientStop Color="#12002A" Offset="0.35"/>
                <GradientStop Color="#2B0A52" Offset="0.7"/>
                <GradientStop Color="#0A0016" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER COM APENAS BOTÃO RESET -->
        <Border Margin="14,14,14,10" CornerRadius="16" Padding="16,14" BorderThickness="1" BorderBrush="#4B2A86">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#12002A" Offset="0"/>
                    <GradientStop Color="#1A0B34" Offset="0.55"/>
                    <GradientStop Color="#12002A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Gameoteca" FontSize="26" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Biblioteca gamer" FontSize="12" Foreground="#D6C8FF" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- APENAS BOTÃO RESET -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Resetar Configurações" 
                            Command="{Binding ResetAllSettingsCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="16,8"
                            MinWidth="180"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14,0,14,14">
            <TabControl>

                <TabItem Header="Jogos">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border CornerRadius="12" BorderBrush="#4B2A86" BorderThickness="1" Padding="12" Margin="0,0,0,12" Background="#12002A">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button Content="Jogar" Command="{Binding PlaySelectedCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                                    <Button Content="Adicionar Jogo" Command="{Binding AddGameCommand}" MinWidth="180"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Games}"
                                 SelectedItem="{Binding SelectedGame}"
                                 Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="160" Height="240" CornerRadius="12" Margin="8" Background="#1A0B34" BorderBrush="#4B2A86" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="10" Opacity="0.4" ShadowDepth="4"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" CornerRadius="11,11,0,0" ClipToBounds="True">
                                                <Grid>
                                                    <Rectangle Fill="{StaticResource PrimaryGradient}" Opacity="0.3"/>
                                                    <TextBlock Text="🎮" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4B2A86" Opacity="0.5"/>
                                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>

                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8" 
                                                            Background="#CC000000" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Plataform}" Foreground="#C084FC" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="1" Background="#231045" CornerRadius="0,0,11,11" Padding="10">
                                                <TextBlock Text="{Binding Title}" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="14" Padding="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#C084FC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#A855F7"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="#10A855F7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Jogar" FontWeight="Bold" Command="{Binding Source={StaticResource Proxy}, Path=Data.PlaySelectedCommand}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                
                                                <MenuItem Header="Definir como PC" Command="{Binding Source={StaticResource Proxy}, Path=Data.ClearGameEmulatorCommand}" />
                                                <Separator/>
                                                <MenuItem Header="Alterar Capa" Command="{Binding Source={StaticResource Proxy}, Path=Data.ChangeGameImageCommand}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Renomear" Command="{Binding Source={StaticResource Proxy}, Path=Data.RenameGameCommand}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Excluir" Foreground="#FF7AB6" Command="{Binding Source={StaticResource Proxy}, Path=Data.RemoveGameCommand}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Emuladores">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="12" BorderBrush="#4B2A86" BorderThickness="1" Padding="12" Margin="0,0,0,12" Background="#12002A">
                            <Button Content="Adicionar Emulador" Command="{Binding AddEmulatorCommand}" MinWidth="180" HorizontalAlignment="Left"/>
                        </Border>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Emulators}" SelectedItem="{Binding SelectedEmulator}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="160" Height="240" CornerRadius="12" Margin="8" Background="#1A0B34" BorderBrush="#4B2A86" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="11,11,0,0" ClipToBounds="True">
                                                <Grid>
                                                    <Rectangle Fill="{StaticResource PrimaryGradient}" Opacity="0.3"/>
                                                    <TextBlock Text="⚙️" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C084FC" Opacity="0.5"/>
                                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Background="#231045" CornerRadius="0,0,11,11" Padding="10">
                                                <TextBlock Text="{Binding Name}" Foreground="White" TextAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Renomear" Command="{Binding Source={StaticResource Proxy}, Path=Data.RenameEmulatorCommand}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Excluir" Command="{Binding Source={StaticResource Proxy}, Path=Data.RemoveEmulatorCommand}" CommandParameter="{Binding}" Foreground="#FF7AB6"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Pastas (Scan)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border CornerRadius="12" BorderBrush="#4B2A86" BorderThickness="1" Padding="12" Margin="0,0,0,12" Background="#12002A">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Adicionar" Command="{Binding AddMappingCommand}" Margin="0,0,10,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="MappingsGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Mappings}"
                                  SelectedItem="{Binding SelectedMapping}"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                  PreviewMouseRightButtonDown="MappingsGrid_PreviewMouseRightButtonDown" 
                                  SelectionChanged="MappingsGrid_SelectionChanged">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Fazer Scan Agora" Command="{Binding Source={StaticResource Proxy}, Path=Data.ScanSelectedMappingCommand}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Alterar Pasta" Command="{Binding Source={StaticResource Proxy}, Path=Data.BrowseMappingFolderCommand}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="Excluir Caminho" Command="{Binding Source={StaticResource Proxy}, Path=Data.RemoveMappingCommand}" CommandParameter="{Binding}" Foreground="#FF7AB6"/>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pasta" Width="3*" Binding="{Binding FolderPath}" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Plataforma" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <ComboBox ItemsSource="{Binding Source={StaticResource Proxy}, Path=Data.AvailablePlatforms}"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding EmulatorId}"
                                                          IsHitTestVisible="False"
                                                          Focusable="False"
                                                          BorderThickness="0"
                                                          Background="Transparent"
                                                          Foreground="#D6C8FF"
                                                          VerticalAlignment="Center">

                                                    <ComboBox.Template>
                                                        <ControlTemplate TargetType="ComboBox">
                                                            <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"/>
                                                        </ControlTemplate>
                                                    </ComboBox.Template>
                                                </ComboBox>

                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#A855F7" StrokeThickness="2" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>

                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource Proxy}, Path=Data.AvailablePlatforms}"
                                                      DisplayMemberPath="Name" 
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding EmulatorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Background="#1A0B34" Foreground="White" IsDropDownOpen="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Extensões (.zip; .iso)" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <Button Content="Outra..." DockPanel.Dock="Right" Margin="5,0,0,0" Padding="8,2"
                                                        Style="{StaticResource PrimaryButton}" MinWidth="60"
                                                        Command="{Binding Source={StaticResource Proxy}, Path=Data.AddCustomExtensionCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ExtensionsText}" VerticalAlignment="Center" Foreground="#D6C8FF"/>
                                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#A855F7" StrokeThickness="2" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                </Grid>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True" Background="#1A0B34">
                                                <Button Content="Outra..." DockPanel.Dock="Right" Margin="5,0,0,0" Padding="8,2"
                                                        Style="{StaticResource PrimaryButton}" MinWidth="60"
                                                        Command="{Binding Source={StaticResource Proxy}, Path=Data.AddCustomExtensionCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <ComboBox ItemsSource="{Binding Source={StaticResource Proxy}, Path=Data.AvailableExtensions}"
                                                          Text="{Binding ExtensionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True" Background="#1A0B34" Foreground="White" BorderThickness="0" IsDropDownOpen="True"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>